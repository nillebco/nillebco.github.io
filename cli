#!/bin/bash

setup() {
    uv venv
    . .venv/bin/activate
    uv pip install -r requirements.txt
}

compile() {
    . .venv/bin/activate
    uv pip compile requirements.in > requirements.txt
}

devsync() {
    . .venv/bin/activate
    uv pip sync requirements.txt
}

serve() {
    python -m http.server 8083
}

build() {
    uv run python build_blog.py
    uv run python generate_rss.py
    npm run -s build
}

# publish = push main, then merge main into the www.nilleb.co Pages branch of nillebco.github.io.
# (www.nilleb.com only redirects to nilleb.co: never merge main into it.)
push() {
    set -e
    git push origin main
    git fetch web-co
    WORKTREE=$(mktemp -d)/www-co
    git worktree add --detach "$WORKTREE" web-co/www.nilleb.co
    git -C "$WORKTREE" merge --no-edit -m "Merge branch 'main' into www.nilleb.co" main
    git -C "$WORKTREE" push web-co HEAD:www.nilleb.co
    git worktree remove "$WORKTREE"
}

setup() {
    uv sync
}

tweet() {
    . .venv/bin/activate
    uv run python create_bsky_post.py ${@}
}

case "$1" in
    setup)
        setup
        ;;
    devcompile)
        compile
        ;;
    serve)
        serve
        ;;
    devsync)
        devsync
        ;;
    build)
        build
        ;;
    push)
        push
        ;;
    rss)
        . .venv/bin/activate
        python3 generate_rss.py
        ;;
    tweet)
        tweet ${@:2}
        ;;
    setup)
        setup
        ;;
    *)
        echo "Error: Invalid command. Available commands: serve, build, push, rss, tweet, setup"
        ;;
esac
